{
  "name": "death-note",
  "version": "0.1.0",
  "private": true,
  "description": "An unofficial, cinematic, animated digital notebook inspired by the concept of Death Note.",
  "author": "h4sib.pro (https://h4sib.pro)",
  "license": "MIT",
  "homepage": "https://h4sib.pro",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "webhook:test": "tsx scripts/send-test-webhook.ts",
    "seed:public": "tsx scripts/seed-public.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/homemade-apple": "^5.3.0",
    "@fontsource/im-fell-english": "^5.3.0",
    "@fontsource/unifrakturcook": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "gsap": "^3.15.1",
    "howler": "^2.2.4",
    "motion": "^14.10.1",
    "next": "^16.4.5",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/howler": "^2.2.13",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "dotenv": "^18.0.9",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "keywords": [
    "death-note",
    "nextjs",
    "threejs",
    "react-three-fiber",
    "gsap",
    "animation",
    "postgresql",
    "prisma",
    "oxapay",
    "notebook"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/KortzLab/DeathNote.git"
  }
}
